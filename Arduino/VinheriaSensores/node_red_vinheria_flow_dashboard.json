    {
        "id": "e0e1e2e3e4f50005",
        "type": "function",
        "z": "e0e1e2e3e4f50001",
        "name": "Separar sensores para os widgets",
        "func": "// Recebe o objeto {temperatura, umidade, luminosidade}\n// e distribui um valor por saída, já rotulado para o\n// Dashboard (gauges e gráfico combinado).\nvar leitura = msg.payload || {};\n\nvar msgTemperatura = {\n    payload: leitura.temperatura,\n    topic: \"Temperatura (°C)\"\n};\nvar msgUmidade = {\n    payload: leitura.umidade,\n    topic: \"Umidade (%)\"\n};\nvar msgLuminosidade = {\n    payload: leitura.luminosidade,\n    topic: \"Luminosidade (lux)\"\n};\n\nreturn [msgTemperatura, msgUmidade, msgLuminosidade];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
