xCell></root></mxGraphModel></diagram><diagram id="d3" name="Detalhe 3 - fluxo IoT e migracao Strangler Fig"><mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="960" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d3_1" value="Vinheria Agnello — Arquitetura de microsserviços · detalhe 3/3" style="text;html=1;fontFamily=Helvetica;fontSize=28;fontStyle=1;fontColor=#7B1E3A;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1400" height="34" as="geometry"/></mxCell><mxCell id="d3_2" value="Adega: sensor → MQTT → bridge → Kafka → ms-qualidade → alerta, e a migração do monolito (Strangler Fig)" style="text;html=1;fontFamily=Helvetica;fontSize=24;fontStyle=0;fontColor=#444444;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1400" height="28" as="geometry"/></mxCell><mxCell id="d3_3" value="&lt;b&gt;Sensor Arduino Uno&lt;/b&gt; — DHT22 (temperatura e umidade) + LDR · leitura a cada 4 s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;fillColor=#F4FAF6;strokeColor=#2E7D4F;strokeWidth=2;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="660" height="86" as="geometry"/></mxCell><mxCell id="d3_4" value="&lt;b&gt;Ponte serial → Node-RED&lt;/b&gt; — Python (RFC 2217) e fluxo Node-RED" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;fillColor=#F4FAF6;strokeColor=#2E7D4F;strokeWidth=2;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="208" width="660" height="86" as="geometry"/></mxCell><mxCell id="d3_5" value="serial (9600 baud)" style="