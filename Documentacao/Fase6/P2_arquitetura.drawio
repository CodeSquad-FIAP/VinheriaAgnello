ounded=1;arcSize=2;html=1;fillColor=#FAFAFC;strokeColor=#6B6F80;strokeWidth=2;dashed=1;dashPattern=8 4;container=0;" vertex="1" parent="1"><mxGeometry x="12" y="205" width="270" height="460" as="geometry"/></mxCell><mxCell id="c11" value="Clientes / canais" style="text;html=1;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#6B6F80;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="26" y="211" width="242" height="30" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style='font-size:19px'&gt;Web&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;navegador · páginas JSP atuais&lt;br&gt;(Servlet/JSP)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#6B6F80;strokeWidth=2;dashed=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="28" y="250" width="238" height="118" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style='font-size:19px'&gt;App mobile&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Android · Room (cache local)&lt;br&gt;OIDC + PKCE&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#6B6F80;strokeWidth=2;dashed=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="28" y="390" width="238" height="118" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style='font-size:18px'&gt;Painel interno da adega&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;operação · alertas de qualidade&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#6B6F80;strokeWidth=2;dashed=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="28" y="530" width="238" height="118" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style='font-size:22px'