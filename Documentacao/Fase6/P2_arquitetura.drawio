nsome qualidade.leitura e publica qualidade.alerta" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;fillColor=#F4FAF6;strokeColor=#2E7D4F;strokeWidth=2;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="562" width="660" height="86" as="geometry"/></mxCell><mxCell id="d3_11" value="publica qualidade.leitura" style="html=1;fontFamily=Helvetica;fontSize=24;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#2E7D4F;strokeWidth=2.5;dashed=1;dashPattern=2 5;fontColor=#2E7D4F;" edge="1" parent="1" source="d3_8" target="d3_10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_12" value="&lt;b&gt;ms-notificacoes + painel da adega&lt;/b&gt; — alerta chega a quem opera a adega" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;fillColor=#F4FAF6;strokeColor=#2E7D4F;strokeWidth=2;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="660" height="86" as="geometry"/></mxCell><mxCell id="d3_13" value="evento qualidade.alerta" style="html=1;fontFamily=Helvetica;fontSize=24;rounded=0;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#2E7D4F;strokeWidth=2.5;dashed=1;dashPattern=2 5;fontColor=#2E7D4F;" edge="1" parent="1" source="d3_10" target="d3_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_14" value="&lt;b&gt;Área de migração — Strangler Fig&lt;/b&gt;&lt;br&gt;O monolito atual fica atrás do gateway até cada domínio ser extraído:&lt;br&gt;• Web Servlet/JSP — &lt;i&gt;Web/src/main/java/br/com/fiap/vinheriaagnello/&lt;/i&gt;&lt;br&gt;• API .NET de estoque — &lt;i&gt;Web/src/VinheriaAgnello.Server/&lt;/i&gt;&lt;br&gt;• extração gradual: 1º a API .NET → ms-estoque; depois catálogo e clientes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;fillColor=#F2F2F2;strokeColor=#555555;strokeWidth=2;dashed=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="690" height="288" as="geometry"/></mxCell><mxCell id="d3_15" value="&lt;b&gt;Regras do desenho&lt;/b&gt;&lt;br&gt;• cliente só fala com serviço através do API Gateway&lt;br&gt;• nenhum serviço acessa o banco de outro — dado cruzado só por API ou evento&lt;br&gt;• nomes de serviços e de tópicos = glossário do P1 + lista do P5&lt;br&gt;• infraestrutura (Redis, registry, mesh, observabilidade, Vault, Node-RED, bridge) não é serviço de domínio" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;fillColor=#F2F2F2;strokeColor=#555555;strokeWidth=2;dashed=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="700" y="388" width="690" height="232" as="geometry"/></mxCell><mxCell id="d3_16" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=24;fontColor=#1A1A1A;fillColor=#F2F2F2;strokeColor=#555555;strokeWidth=2;dashed=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="700" y="630" width="690" height="312" as="geometry"/></mxCell><mxCell id="d3_17" value="Legenda" style="text;html=1;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#333333;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="722" y="642" width="650" height="30" as="geometry"/></mxCell><mxCell id="d3_18" value="" style="shape=point;strokeColor=none;fillColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="722" y="702" width="1" height="1" as="geometry"/></mxCell><mxCell id="d3_19" value="" style="shape=point;strokeColor=none;fillColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="792" y="702" width="1" height="1" as="geometry"/></mxCell><mxCell id="d3_20" value="" style="html